# LPAEZSIS — COMEX / AUTO_OPERACIONES
# BlueHosting (cPanel, CloudLinux CageFS, PHP 8.1.x)
# Copiar a .env en el document root y completar credenciales de cPanel.
# Nunca commitear contraseñas reales.

APP_ENV=production
APP_DEBUG=0
DISPLAY_ERRORS=off
APP_NAME="COMEX LPAEZsis"
APP_URL=https://comex.lpaezsis.cl
APP_TZ=America/Santiago
SESSION_HOURS=12

# mysql (producción BlueHosting) | sqlite (preview / tests locales)
COMEX_DB_DRIVER=mysql

# MySQL / MariaDB (PDO) — cPanel, misma convención que crm.lpaezsis.cl
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistem29_comex
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql
DB_CHARSET=utf8mb4

# SQLite de la app (solo si COMEX_DB_DRIVER=sqlite)
# COMEX_SQLITE_PATH=data/comex.db

# SQLite de inventario.lpaezsis.cl (Prisma: Product + Movement).
# Ruta absoluta en CageFS. Lectura de catálogo y, al confirmar COMEX, escritura
# ENTRADA/SALIDA con WAL + busy_timeout (PHP-FPM). El directorio debe ser 775
# para poder crear prod.db-wal / prod.db-shm.
INV_SQLITE_PATH=/home/sistem29/app/data/prod.db
INV_SQLITE_WAL=1
INV_SQLITE_BUSY_TIMEOUT_MS=8000
INV_SQLITE_RETRIES=8
# INV_SQLITE_READ_ONLY=1

# IVA Chile (aduanero sobre CIF)
IVA_PCT=19
