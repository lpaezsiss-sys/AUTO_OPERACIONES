# CRM Industrial Omnicanal B2B — crm.lpaezsis.cl
# PHP 7.4 LTS (BlueHosting). Copiar a .env y completar credenciales de cPanel.

# mysql (producción BlueHosting) | sqlite (preview local)
CRM_DB_DRIVER=mysql

# MySQL / MariaDB (PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistem29_crm
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql
DB_CHARSET=utf8mb4

# SQLite (solo si CRM_DB_DRIVER=sqlite)
# CRM_SQLITE_PATH=data/crm.sqlite

APP_DEBUG=0
APP_NAME="CRM LPAEZsis"
APP_URL=https://crm.lpaezsis.cl
SESSION_HOURS=12

# IVA Chile
IVA_PCT=19
