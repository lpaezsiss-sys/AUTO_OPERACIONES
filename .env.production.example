# Producción — BlueHosting / cPanel Node.js / VPS
NODE_ENV=production

# Puerto: en cPanel Node.js App suele asignarlo el panel (no hace falta forzar).
# PORT=3000

# SQLite en carpeta escribible (recomendado para empezar en Node App)
# Ruta relativa al directorio prisma/ → crea data/prod.db en la raíz de la app
DATABASE_URL="file:../data/prod.db"

# Si tu plan trae MySQL, cambia prisma/schema.prisma a provider = "mysql" y usa:
# DATABASE_URL="mysql://USUARIO:PASSWORD@localhost:3306/NOMBRE_BD"

# Secreto de sesión (genera uno largo y único)
AUTH_SECRET="cambia-este-secreto-largo-y-aleatorio"

# Obliga cookies Secure (necesitas HTTPS en el dominio)
COOKIE_SECURE=true

# NO pongas HOSTNAME=0.0.0.0 en cPanel (rompe el login / redirects).

# Solo la primera vez, en el servidor:
# RUN_SEED=true  (y reinicia una vez)  O  ejecuta: node scripts/seed-admin.mjs
RUN_SEED=false
