# CRM LPAEZsis — plantilla de producción (BlueHosting / crm.lpaezsis.cl)
# Copiar a .env en el document root y completar DB_* de cPanel.
# No subir este archivo con contraseñas reales al repositorio.

APP_ENV=production
APP_URL=https://crm.lpaezsis.cl
APP_NAME="CRM LPAEZsis"
APP_DEBUG=0
DISPLAY_ERRORS=off

# MySQL / MariaDB (PDO) — cPanel
CRM_DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

IVA_PCT=19
SESSION_HOURS=12
