# COMEX LPAEZsis — plantilla de producción (BlueHosting / comex.lpaezsis.cl)
# Copiar a .env en el document root y completar DB_* de cPanel.
# No subir este archivo con contraseñas reales al repositorio.
# Excluir .env de la sincronización WebDAV (puerto 2078) para no pisar secretos.

APP_ENV=production
APP_URL=https://comex.lpaezsis.cl
APP_NAME="COMEX LPAEZsis"
APP_DEBUG=0
DISPLAY_ERRORS=off
APP_TZ=America/Santiago
SESSION_HOURS=12

COMEX_DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Inventario existente (inventario.lpaezsis.cl) — SQLite Prisma Product + Movement
INV_SQLITE_PATH=/home/sistem29/app/data/prod.db
INV_SQLITE_WAL=1
INV_SQLITE_BUSY_TIMEOUT_MS=8000
INV_SQLITE_RETRIES=8

IVA_PCT=19

LPAEZSIS_HOSTS=comex.lpaezsis.cl,crm.lpaezsis.cl,inventario.lpaezsis.cl
