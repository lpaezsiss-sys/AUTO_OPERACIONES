  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "ext-zip": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crm\\": "src/Crm/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.34"
    }
  }
}
